# Puerto único para el monolito (Frontend + Backend + WebSocket)
PORT=3000

# Clave de Google AI Studio (Opcional, también configurable desde la interfaz web)
GEMINI_API_KEY=

# Credenciales de Administrador (Login Exclusivo en Coolify / .env)
AUTH_EMAIL=admin@admin.com
AUTH_PASSWORD=admin123

# Secreto para firma de tokens (Opcional, se genera uno por defecto si se omite)
JWT_SECRET=tu_secreto_super_seguro_aqui

# ==============================================================================
# MEMORIA CONVERSACIONAL DE WHATSAPP & BASES DE DATOS (POSTGRESQL + SUPABASE)
# ==============================================================================
# Habilitar memoria conversacional persistente para el bot (true / false)
BOT_MEMORY_ENABLED=true

# Número de turnos conversacionales que recordará Gemini (1 turno = pregunta + respuesta)
# Ejemplo: 10 turnos = 20 mensajes previos enviados como contexto en el chat
BOT_MEMORY_TURNS=10

# ------------------------------------------------------------------------------
# 1. Base de Datos Primaria: PostgreSQL (en tu Servidor Oracle / Oracle Cloud OCI)
# ------------------------------------------------------------------------------
# Opción A (Recomendada): Cadena de conexión completa
DATABASE_URL=postgresql://usuario:tu_password@oracle-host:5432/whatsappbot_db?sslmode=disable

# Opción B: Variables individuales (se usan si DATABASE_URL está vacía)
# PG_HOST=tu-servidor-oracle-ip
# PG_PORT=5432
# PG_DATABASE=whatsappbot_db
# PG_USER=postgres
# PG_PASSWORD=tu_password
# PG_SSL=false

# ------------------------------------------------------------------------------
# 2. Base de Datos de Respaldo: Supabase (Conmutación automática por Failover)
# ------------------------------------------------------------------------------
# Supabase REST API (URL del proyecto y Service Role Key / Anon Key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_service_role_o_anon_key

# (Opcional) Cadena directa de conexión al PostgreSQL Pooler de Supabase
# SUPABASE_DB_URL=postgresql://postgres.tu-proyecto:tu_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
